<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Items | Inventory Management</title>
</head>
<body>
    <%  for (let i = items.length - 1; i >= 0; i--) { %>
        <div class="card">
            <h2><%= items[i].name %></h2>
            <p><%= items[i].stock_quantity %></p>
        </div>
    <% } %>
</body>
</html>